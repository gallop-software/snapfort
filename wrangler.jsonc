{
  // SnapFort.io: the game's files are static assets; the Worker in ./worker runs the one
  // shared world as a Durable Object (WebSockets at /ws, saved in its SQLite database).
  // `npm run deploy` builds and publishes to snapfort.io, www.snapfort.io and snapfort.webplantmedia.workers.dev.
  "name": "snapfort",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Keep the free workers.dev address alongside the custom domains.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths always reach the Worker, never the static files.
    "run_worker_first": ["/ws", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "routes": [
    { "pattern": "snapfort.io", "custom_domain": true },
    { "pattern": "www.snapfort.io", "custom_domain": true }
  ]
}
