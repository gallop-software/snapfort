{
  "name": "snapfort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "qa": "node qa/qa.mjs",
    "qa:multi": "node qa/multi.mjs",
    "qa:load": "node qa/load.mjs",
    "qa:trebuchet": "node qa/trebuchet.mjs",
    "qa:chaos": "node qa/chaos.mjs",
    "qa:mobile": "node qa/mobile.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1",
    "@babylonjs/havok": "^1.3.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261121.1",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
